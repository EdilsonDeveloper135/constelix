{
  "name": "@constelix/agent",
  "version": "0.0.9",
  "description": "Local-first agent and CLI for the Constelix visual engineering workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdilsonDeveloper135/constelix.git",
    "directory": "apps/agent"
  },
  "homepage": "https://github.com/EdilsonDeveloper135/constelix#readme",
  "bugs": {
    "url": "https://github.com/EdilsonDeveloper135/constelix/issues"
  },
  "keywords": [
    "code-graph",
    "developer-tools",
    "local-first",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "constelix": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch --exclude \"**/node_modules/**\" src/cli.ts -- --dev",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "13.0.3",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ignore": "^7.0.12",
    "nanoid": "^6.0.2",
    "node-pty": "1.1.0",
    "openai": "^7.32.0",
    "pyright": "1.1.414",
    "tree-sitter": "0.25.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "typescript-language-server": "6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@constelix/analyzers": "workspace:*",
    "@constelix/contracts": "workspace:*",
    "@constelix/graph-core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.5.1"
  }
}
