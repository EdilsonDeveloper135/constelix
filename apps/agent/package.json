{
  "name": "@constelix/agent",
  "version": "0.0.8",
  "description": "Local-first agent and CLI for the Constelix visual engineering workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdilsonDeveloper135/constelix.git",
    "directory": "apps/agent"
  },
  "homepage": "https://github.com/EdilsonDeveloper135/constelix#readme",
  "bugs": {
    "url": "https://github.com/EdilsonDeveloper135/constelix/issues"
  },
  "keywords": [
    "code-graph",
    "developer-tools",
    "local-first",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "constelix": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch --exclude \"**/node_modules/**\" src/cli.ts -- --dev",
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "12.11.1",
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "ignore": "^7.0.6",
    "nanoid": "^6.0.1",
    "node-pty": "1.1.0",
    "openai": "^6.49.0",
    "pyright": "1.1.411",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-python": "0.23.2",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@constelix/analyzers": "workspace:*",
    "@constelix/contracts": "workspace:*",
    "@constelix/graph-core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.5.1"
  }
}
