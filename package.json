{
  "name": "constelix",
  "version": "0.0.8",
  "private": true,
  "description": "A local-first visual software engineering workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdilsonDeveloper135/constelix.git"
  },
  "homepage": "https://github.com/EdilsonDeveloper135/constelix#readme",
  "bugs": {
    "url": "https://github.com/EdilsonDeveloper135/constelix/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "node --import tsx scripts/run-dev.ts",
    "dev:agent": "pnpm --filter @constelix/agent dev",
    "dev:web": "pnpm --filter @constelix/web dev",
    "build": "pnpm -r build && pnpm package:cli",
    "package:cli": "node --import tsx scripts/package-cli.ts",
    "version:check": "node --import tsx scripts/check-version.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "node --import tsx scripts/run-benchmark.ts && node --import tsx scripts/run-runtime-benchmark.ts",
    "benchmark:fixture": "node --import tsx scripts/generate-benchmark.ts",
    "smoke:codex": "node --import tsx scripts/smoke-codex.ts",
    "smoke:lsp": "node --import tsx scripts/smoke-lsp.ts",
    "smoke:package": "node --import tsx scripts/smoke-packaged-cli.ts",
    "audit:deps": "pnpm audit --audit-level low",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "check": "pnpm version:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
